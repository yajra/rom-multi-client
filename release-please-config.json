{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "xml",
          "path": "src/ROInstances.csproj",
          "xpath": "/Project/PropertyGroup/Version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Build and Automation",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Maintenance",
          "hidden": true
        }
      ]
    }
  }
}
